{
	"name": "playpen",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Manage Lima VMs as disposable agent sandboxes",
	"license": "MIT",
	"engines": {
		"node": ">=23.6"
	},
	"bin": {
		"playpen": "./src/cli.ts"
	},
	"scripts": {
		"playpen": "node src/cli.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --test --experimental-test-module-mocks \"src/**/*.test.ts\"",
		"lint": "biome check && npm run prettier:check",
		"lint:fix": "biome check --write && npm run prettier:fix",
		"format": "biome check --write",
		"prettier:check": "prettier --check --cache .",
		"prettier:fix": "prettier --write --cache .",
		"verify": "npm run test && npm run lint:fix && npm run typecheck"
	},
	"dependencies": {
		"citty": "^0.1.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "^24.0.0",
		"prettier": "3.9.7",
		"typescript": "^5.8.0"
	}
}
